# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/

# Local data — the corpus lives outside the install (see docs), but never commit it here either
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# Local run configuration (holds API keys, the R2 secret, the Postgres DSN)
.env
env.local

# Terraform working state (infra/ is the config; the state names the project and
# the plugin cache is machine-local). Secret *values* never enter state — see
# infra/README.md.
infra/.terraform/
infra/*.tfstate*
infra/*.tfvars

# Session artifacts
.playwright-mcp/
.DS_Store
